
{%- liquid
  assign shop_name = 'Malnad Products'
  assign packer_name = 'Malnad Spices'
  assign street = 'Devaramane, Horanadu Post, Kalasa Taluk'
  assign locality = 'Chikkamagaluru'
  assign region = 'Karnataka'
  assign postcode = '577181'
  assign phone_one = '+91-8431218956'
  assign phone_two = '+91-9480956035'
  assign care_email = 'drjhrnd5@gmail.com'
-%}

{%- capture organization -%}
  {
    "@type": "Organization",
    "@id": {{ request.origin | append: '/#organization' | json }},
    "name": {{ shop_name | json }},
    "alternateName": {{ packer_name | json }},
    "url": {{ request.origin | json }},
    "email": {{ care_email | json }},
    "telephone": {{ phone_one | json }},
    "foundingDate": "1999",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ street | json }},
      "addressLocality": {{ locality | json }},
      "addressRegion": {{ region | json }},
      "postalCode": {{ postcode | json }},
      "addressCountry": "IN"
    },
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": {{ phone_one | json }},
        "email": {{ care_email | json }},
        "areaServed": "IN",
        "availableLanguage": ["en", "kn"]
      },
      {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": {{ phone_two | json }},
        "areaServed": "IN"
      }
    ]
    {%- if settings.logo -%}
      ,"logo": {
        "@type": "ImageObject",
        "url": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
      }
    {%- endif -%}
  }
{%- endcapture -%}

{%- comment -%}
  Organization and WebSite are emitted on every page so the entity is asserted
  consistently and product graphs can reference it by @id.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {{ organization }},
    {
      "@type": "WebSite",
      "@id": {{ request.origin | append: '/#website' | json }},
      "name": {{ shop_name | json }},
      "url": {{ request.origin | json }},
      "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "inLanguage": "en-IN",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ request.origin | append: '/search?q={search_term_string}' | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>

