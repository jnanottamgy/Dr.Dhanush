{
  "sections": {
    "hero": {
      "type": "malnad-hero",
      "settings": {
        "image": "shopify://shop_images/hero-canopy.png",
        "kicker": "Horanadu, Chikkamagaluru · since 1999",
        "heading": "The Malnad pantry, packed the day you order it",
        "body": "Spices, coffee and estate goods from the Western Ghats — weighed out by hand, with every declaration read off the pack you actually receive.",
        "button_label": "Shop the catalogue",
        "button_link": "shopify://collections/all",
        "button_2_label": "Who we are",
        "button_2_link": "shopify://pages/about",
        "text_color": "#F4F2ED",
        "overlay_color": "#0D2119",
        "min_height": 600,
        "padding_block_start": 0,
        "padding_block_end": 0
      },
      "blocks": {},
      "block_order": []
    },
    "promise": {
      "type": "malnad-promise",
      "settings": {
        "background_color": "#F2F0EA",
        "rule_color": "#DCE0D8",
        "accent_color": "#A4552F",
        "padding_block_start": 8,
        "padding_block_end": 44
      },
      "blocks": {
        "p1": {
          "type": "promise",
          "settings": {
            "icon": "label",
            "title": "Read off the pack",
            "text": "Net quantity, MRP, packing date, best before. Where a pack does not print one, the listing says so instead of filling it in."
          }
        },
        "p2": {
          "type": "promise",
          "settings": {
            "icon": "scale",
            "title": "Weighed to order",
            "text": "Nothing sits sealed on a shelf. We measure it out when the order comes in."
          }
        },
        "p3": {
          "type": "promise",
          "settings": {
            "icon": "lock",
            "title": "Prepaid checkout",
            "text": "Secure payment online. We do not offer cash on delivery."
          }
        },
        "p4": {
          "type": "promise",
          "settings": {
            "icon": "truck",
            "title": "Delivered across India",
            "text": "Dispatched in two to three working days from Horanadu."
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3",
        "p4"
      ]
    },
