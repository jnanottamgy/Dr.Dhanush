{% comment %}
  Category grid. Each card prefers the collection's own image and falls back to
  the first product's pack photograph, so a category is never a grey box even
  before anyone uploads artwork for it.
{% endcomment %}

{%- liquid
  assign s = section.settings
-%}

<section
  class="mcats"
  style="
    --mcats-cols: {{ s.columns }};
    padding-block-start: {{ s.padding_block_start }}px;
    padding-block-end: {{ s.padding_block_end }}px;
  "
>
  <div class="mcats__inner">
    {%- if s.heading != blank or s.link_label != blank -%}
      <div class="mcats__head">
        {%- if s.heading != blank -%}
          <h2 class="mcats__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="mcats__all" href="{{ s.link_url | default: '/collections/all' }}">
            {{- s.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mcats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign img = coll.image
          if img == blank
            assign img = coll.products.first.featured_image
          endif
          assign label = block.settings.label | default: coll.title
        -%}
        {%- if coll != blank -%}
          <a class="mcat" href="{{ coll.url }}" {{ block.shopify_attributes }}>
            <span class="mcat__frame">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 700px) 50vw, 25vw',
                    widths: '300, 450, 600, 900',
                    class: 'mcat__img',
                    alt: label
                }}
              {%- endif -%}
            </span>
            <span class="mcat__label">
              <span class="mcat__title">{{ label | escape }}</span>
              <span class="mcat__count">
                {{- coll.all_products_count }}
                {%- if coll.all_products_count == 1 %} item{% else %} items{% endif -%}
              </span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mcats__inner {
    max-width: var(--page-width, 1320px);
    margin-inline: auto;
    padding-inline: max(24px, env(safe-area-inset-left, 0px));
  }

  .mcats__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-block-end: 28px;
  }

  .mcats__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.015em;
  }

  .mcats__all {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-block-end: 1px solid currentcolor;
    padding-block-end: 3px;
    white-space: nowrap;
  }

  .mcats__grid {
    display: grid;
    grid-template-columns: repeat(var(--mcats-cols, 4), minmax(0, 1fr));
    gap: 20px;
  }

  .mcat {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Fixed ratio so cards line up whatever shape the pack photo is. */
  .mcat__frame {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
    background: var(--color-background, #f2f0ea);
  }

  .mcat__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .mcat:hover .mcat__img { transform: scale(1.03); }

  @media (prefers-reduced-motion: reduce) {
    .mcat__img { transition: none; }
    .mcat:hover .mcat__img { transform: none; }
  }

  .mcat__label {
    display: block;
    padding-block-start: 12px;
  }

  .mcat__title {
    display: block;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .mcat__count {
    display: block;
    margin-block-start: 3px;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.62;
    font-variant-numeric: tabular-nums;
  }

  @media screen and (max-width: 900px) {
    .mcats__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 640px) {
    .mcats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .mcats__inner { padding-inline: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Malnad categories",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by shelf" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All products" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_block_start", "label": "Top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_block_end", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [{ "name": "Malnad categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
